{
    "name": "ripple/backend",
    "description": "Ripple — PHP WebSocket chat backend",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-mysqli": "*",
        "ext-sockets": "*",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Ripple\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "@php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-html coverage --coverage-text"
    }
}
